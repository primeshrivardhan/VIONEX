# ====================================================================
# Android Release Signing Configuration (LOCAL ONLY - NEVER COMMIT!)
# ====================================================================
# Copy this file to "keystore.properties" (in android/ or android/app/)
# and fill in your actual keystore details.
#
# Path to your .jks keystore file (can be absolute or relative to android/app)
# Example: D:/VIONEX/vionex-release-key.jks or ../../vionex-release-key.jks
storeFile=../../vionex-release-key.jks

# Keystore password
storePassword=your_keystore_password_here

# Key alias name (e.g., vionex-key)
keyAlias=vionex-key

# Key password (often the same as storePassword)
keyPassword=your_key_password_here
