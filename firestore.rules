rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && 
             'email' in request.auth.token && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() == "primeshrivardhan@gmail.com";
    }

    function getUserMapping() {
      return exists(/databases/$(database)/documents/user_mappings/$(request.auth.uid)) ? 
             get(/databases/$(database)/documents/user_mappings/$(request.auth.uid)).data : 
             null;
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    function isRestrictedDemoUser() {
      // Returns true if the user's role is strictly 'user' (Demo role)
      return isSignedIn() && !isAdmin() && getUserMapping() != null && getUserMapping().role == "user";
    }

    function isConsultant() {
      return isSignedIn() && 
             !isAdmin() && 
             getUserMapping() != null && 
             getUserMapping().role == "consultant";
    }

    // User Mappings - Connects Anonymous/Auth UID to Custom User Profile
    // Clients can NEVER self-assign the 'admin' or 'consultant' role
    match /user_mappings/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      allow write: if (
        request.auth.uid == uid && 
        (!('role' in request.resource.data) || (request.resource.data.role != 'admin' && request.resource.data.role != 'consultant'))
      ) || isAdmin();
    }

    // Users Collection - Secured to Admins and Document Owners
    // Clients can NEVER read other users' accounts or self-assign/escalate their role
    match /users/{userId} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          request.auth.uid == userId || 
          (getUserMapping() != null && getUserMapping().userId == userId)
        )
      );
      allow list: if isAdmin();
      allow update, delete: if isAdmin() || (
        getUserMapping() != null && 
        getUserMapping().userId == userId && 
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
      );
      allow create: if isAdmin() || (
        isSignedIn() && 
        (!('role' in request.resource.data) || (request.resource.data.role != 'admin' && request.resource.data.role != 'consultant'))
      );
    }

    // Farmers Collection - Read for login, restricted writes
    match /farmers/{farmerId} {
      // Demo/Read-only users cannot read actual business data
      allow read: if isSignedIn() && !isRestrictedDemoUser();
      allow create: if isSignedIn() && !isRestrictedDemoUser() && (
        isAdmin() || 
        (isConsultant() && request.resource.data.createdBy == request.auth.uid) ||
        (!isConsultant() && !isAdmin())
      );
      allow update: if isAdmin() || (
        isConsultant() && 
        resource.data.createdBy == request.auth.uid && 
        request.resource.data.createdBy == resource.data.createdBy
      ) || request.auth.uid == resource.data.id || request.auth.uid == resource.data.createdBy;
      allow delete: if isAdmin() || (
        isConsultant() && 
        'createdBy' in resource.data && 
        resource.data.createdBy != null && 
        resource.data.createdBy == request.auth.uid
      );
    }

    // Master Data - Admin write, Consultant limited create
    match /products/{productId} {
      allow read: if !isRestrictedDemoUser();
      allow create: if isAdmin() || isConsultant();
      allow update, delete: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if !isRestrictedDemoUser();
      allow create: if isAdmin() || isConsultant();
      allow update: if isAdmin() || (isConsultant() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /crops/{cropId} {
      allow read: if !isRestrictedDemoUser();
      allow write: if isAdmin();
    }

    match /master-locations/{locationId} {
      allow read: if !isRestrictedDemoUser();
      allow write: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Public Submissions (Dealers, Consultants) - Anyone can create, only admin can update/delete
    match /dealers/{dealerId} {
      allow read: if !isRestrictedDemoUser();
      allow create: if isSignedIn() || true; // Public form
      allow update, delete: if isAdmin();
    }

    match /consultants/{consultantId} {
      allow read: if !isRestrictedDemoUser();
      allow create: if isSignedIn() || true; // Public form
      allow update, delete: if isAdmin();
    }

    // Logs - Append only for users, full access for admin
    match /activity-logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && !isRestrictedDemoUser();
      allow update, delete: if isAdmin();
    }
    
    match /api-error-logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Test collection for validation
    match /test/connection {
      allow read: if true;
    }
  }
}
